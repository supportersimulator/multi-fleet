# Multi-Fleet Environment Variables
# Copy to .env and fill in your values.

# ── Node Identity ──────────────────────────────────────────────
# Unique name for this machine in the fleet (e.g., mac1, mac2, mac3).
# If unset, defaults to lowercase hostname.
MULTIFLEET_NODE_ID=

# ── Network ────────────────────────────────────────────────────
# NATS server URL for P1 pub/sub channel
NATS_URL=nats://127.0.0.1:4222

# Fleet Nerve daemon HTTP port (P2 channel)
FLEET_NERVE_PORT=8855

# SSH user for P4/P5 channels (defaults to $USER)
# FLEET_SSH_USER=

# ── API Keys ──────────────────────────────────────────────────
# Prefer macOS Keychain over env vars (see README for setup).
#   security add-generic-password -s fleet-nerve-openai -a "$USER" -w "sk-..."
#   security add-generic-password -s fleet-nerve-deepseek -a "$USER" -w "sk-..."
#
# Env var fallbacks (only if Keychain is unavailable):
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
#
# Internal names used by the plugin (set automatically from Keychain):
# Context_DNA_OPENAI=
# Context_DNA_Deepseek=
