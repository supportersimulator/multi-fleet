<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  io.contextdna.fleet-nats — Fleet NATS bridge daemon
  Connects fleet_nerve_nats.py to the local NATS server for pub/sub messaging.
  Runs the HTTP daemon on port 8855.

  Placeholders:
    __HOME__        — User home directory
    __REPO_ROOT__   — Absolute path to er-simulator-superrepo checkout
    __NODE_ID__     — Fleet node identifier (e.g. mac1, mac2, mac3)
    __PYTHON_PATH__ — Absolute path to python3 binary
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.contextdna.fleet-nats</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON_PATH__</string>
        <string>__REPO_ROOT__/tools/fleet_nerve_nats.py</string>
        <string>serve</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>MULTIFLEET_NODE_ID</key>
        <string>__NODE_ID__</string>
        <key>NATS_URL</key>
        <string>nats://127.0.0.1:4222</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>__REPO_ROOT__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/fleet-nats.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/fleet-nats.log</string>
</dict>
</plist>
