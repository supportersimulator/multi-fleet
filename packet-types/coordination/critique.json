{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type_name": "critique",
  "version": 1,
  "owner": "coordination",
  "description": "One node's review of another's work on a branch",
  "payload": {
    "type": "object",
    "properties": {
      "target_branch": {"type": "string"},
      "agrees": {"type": "boolean"},
      "concerns": {"type": "array", "items": {"type": "string"}},
      "suggestions": {"type": "array", "items": {"type": "string"}},
      "confidence": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "required": ["target_branch", "agrees"]
  },
  "ttl_s": 3600,
  "priority": "normal"
}
