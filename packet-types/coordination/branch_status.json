{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type_name": "branch_status",
  "version": 1,
  "owner": "coordination",
  "description": "Node reports its current branch state",
  "payload": {
    "type": "object",
    "properties": {
      "branch": {"type": "string"},
      "commit": {"type": "string"},
      "dirty": {"type": "boolean"},
      "files_changed": {"type": "integer", "minimum": 0},
      "summary": {"type": "string"},
      "ahead_behind": {"type": "string"}
    },
    "required": ["branch", "commit", "dirty"]
  },
  "ttl_s": 120,
  "priority": "low"
}
