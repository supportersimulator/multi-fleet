# Multi-Fleet v2.0.0 -- Codex CLI configuration
# Copy to your project root as codex-config.toml and set MULTIFLEET_NODE_ID.

[mcp_servers.fleet-nerve]
command = "python3"
args = ["multi-fleet/tools/fleet_nerve_mcp.py"]

[mcp_servers.fleet-nerve.env]
MULTIFLEET_NODE_ID = ""
FLEET_NERVE_PORT = "8855"

# Available tools (exposed via MCP)
# tools = ["using_multi_fleet", "fleet_send", "fleet_status", "fleet_task", "fleet_wake", "fleet_repair", "fleet_tunnel", "fleet_watchdog", "fleet_check", "fleet_worker", "productivity_view", "cmd_fleet_check", "cmd_fleet_dashboard", "cmd_fleet_repair", "cmd_fleet_send", "cmd_fleet_status", "cmd_fleet_task", "cmd_fleet_tunnel", "cmd_fleet_wake", "cmd_fleet_watchdog", "cmd_fleet_worker"]

# Skills (slash commands): /using-multi-fleet, /fleet-send, /fleet-status, /fleet-task, /fleet-wake, /fleet-repair, /fleet-tunnel, /fleet-watchdog, /fleet-check, /fleet-worker, /productivity-view
# Commands: /fleet-check, /fleet-dashboard, /fleet-repair, /fleet-send, /fleet-status, /fleet-task, /fleet-tunnel, /fleet-wake, /fleet-watchdog, /fleet-worker
